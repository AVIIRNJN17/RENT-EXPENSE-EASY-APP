      shareWhatsAppByIndex(state.activeReceiptIndex);
    }

    function copyReceiptText() {
      const record = state.rentRecords[state.activeReceiptIndex];
      if (!record) return;
      const text = generateReceiptTextMessage(record);

      const tempTextArea = document.createElement('textarea');
      tempTextArea.value = text;
      document.body.appendChild(tempTextArea);
      tempTextArea.select();
      try {
        document.execCommand('copy');
        showToast('Receipt slip copied to clipboard!');
      } catch (err) {
        showToast('Failed to copy', 'warning');
      }
      document.body.removeChild(tempTextArea);
    }

    // ==========================================
    // 2. ELECTRICITY BILL LOGIC
    // ==========================================
    function calculateCurrentElectricityNumber() {
      const prev = Number(document.getElementById('meterPrevReading').value) || 0;
      const curr = Number(document.getElementById('meterCurrentReading').value) || 0;
      const rate = Number(document.getElementById('meterRatePerUnit').value) || 0;
      const fixed = Number(document.getElementById('meterFixedCharges').value) || 0;
      const units = Math.max(0, curr - prev);
      return (units * rate) + fixed;
    }

    function calculateElectricityBill() {
      const prev = Number(document.getElementById('meterPrevReading').value) || 0;
      const curr = Number(document.getElementById('meterCurrentReading').value) || 0;
      const rate = Number(document.getElementById('meterRatePerUnit').value) || 0;
      const fixed = Number(document.getElementById('meterFixedCharges').value) || 0;

      const units = Math.max(0, curr - prev);
      const total = (units * rate) + fixed;

      document.getElementById('calcTotalUnits').innerText = units;
      document.getElementById('calcTotalBill').innerText = `₹${total.toLocaleString('en-IN')}`;

      document.getElementById('statPowerBill').innerText = `₹${total.toLocaleString('en-IN')}`;
      document.getElementById('statPowerUnits').innerText = `${units} Units consumed`;
    }

    function saveElectricityReading() {
      const prev = Number(document.getElementById('meterPrevReading').value) || 0;
      const curr = Number(document.getElementById('meterCurrentReading').value) || 0;
      const rate = Number(document.getElementById('meterRatePerUnit').value) || 0;
      const fixed = Number(document.getElementById('meterFixedCharges').value) || 0;
      const units = Math.max(0, curr - prev);
      const total = (units * rate) + fixed;

      const log = {
        id: 'elec-' + Date.now(),
        prevReading: prev,
        currReading: curr,
        rate: rate,
        units: units,
        fixed: fixed,
        total: total,
        date: new Date().toISOString().slice(0, 10)
      };

      state.electricityLogs.unshift(log);
      renderElectricityHistory();
      showToast(`Saved! ${units} units bill ₹${total}`);
    }

    function renderElectricityHistory() {
      const container = document.getElementById('meterHistoryList');
      container.innerHTML = '';

      if (state.electricityLogs.length === 0) {
        container.innerHTML = `<p class="text-xs text-slate-400 py-3 text-center">No meter readings saved yet.</p>`;
        return;
      }

      state.electricityLogs.forEach(item => {
        const div = document.createElement('div');
        div.className = 'p-2.5 rounded-xl border border-slate-100 bg-slate-50 flex items-center justify-between text-xs';
        div.innerHTML = `
          <div>
            <div class="font-semibold text-slate-800">${item.units} Units <span class="text-[11px] text-slate-400 font-normal">(${item.prevReading} → ${item.currReading})</span></div>
            <span class="text-[10px] text-slate-500">${item.date} @ ₹${item.rate}/unit</span>
          </div>
          <div class="text-right">
            <span class="font-bold text-amber-700">₹${item.total}</span>
          </div>
        `;
        container.appendChild(div);
      });
    }

    function applyElectricityToLatestRent() {
      const total = calculateCurrentElectricityNumber();
      const prev = Number(document.getElementById('meterPrevReading').value) || 0;
      const curr = Number(document.getElementById('meterCurrentReading').value) || 0;
      const rate = Number(document.getElementById('meterRatePerUnit').value) || 0;
      const units = Math.max(0, curr - prev);

      if (state.rentRecords.length === 0) {
        showToast('No rent record found! Creating a record first...', 'warning');
        switchTab('rent');
        return;
      }

      const latest = state.rentRecords[0];
      latest.electricityAmount = total;
      latest.electricityUnits = `${units} Units (${prev} - ${curr} @ ₹${rate}/u)`;
      latest.totalAmount = latest.baseRent + latest.electricityAmount + latest.otherCharges;

      renderRentRecords();
      updateSummaryWidgets();
      showToast(`Electricity bill ₹${total} added to ${latest.monthLabel} rent!`);
      switchTab('rent');
    }

