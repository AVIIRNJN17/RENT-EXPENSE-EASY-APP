      document.getElementById('currentDateDisplay').innerText = today.toLocaleDateString('en-IN', options);

      const monthStr = today.toISOString().slice(0, 7);
      document.getElementById('rentMonthYear').value = monthStr;
      document.getElementById('expenseDate').value = today.toISOString().slice(0, 10);

      calculateElectricityBill();
      renderAll();
    };

    function switchTab(tabKey) {
      state.activeTab = tabKey;
      
      const sections = ['rent', 'electricity', 'daily', 'ration'];
      sections.forEach(sec => {
        const el = document.getElementById(`section-${sec}`);
        if (el) {
          if (sec === tabKey) {
            el.classList.remove('hidden');
            el.classList.add('block');
          } else {
            el.classList.add('hidden');
            el.classList.remove('block');
          }
        }

        // Desktop nav tab styling
        const dTab = document.getElementById(`tab-${sec}-desktop`);
        if (dTab) {
          if (sec === tabKey) {
            dTab.classList.add('border-indigo-400', 'text-white');
            dTab.classList.remove('border-transparent', 'text-slate-300');
          } else {
            dTab.classList.remove('border-indigo-400', 'text-white');
            dTab.classList.add('border-transparent', 'text-slate-300');
          }
        }

        // Mobile bottom nav keys styling
        const mTab = document.getElementById(`tab-${sec}-mobile`);
        if (mTab) {
          if (sec === tabKey) {
            mTab.classList.add('text-indigo-600', 'bg-indigo-50/80');
            mTab.classList.remove('text-slate-400');
          } else {
            mTab.classList.remove('text-indigo-600', 'bg-indigo-50/80');
            mTab.classList.add('text-slate-400');
          }
        }
      });

      updateSummaryWidgets();
    }

