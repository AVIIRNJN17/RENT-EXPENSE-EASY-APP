    function shareWhatsAppByIndex(idx) {
      const record = state.rentRecords[idx];
      if (!record) return;
      const text = generateReceiptTextMessage(record);
      const encoded = encodeURIComponent(text);
      const phone = record.ownerPhone ? record.ownerPhone.replace(/[^0-9]/g, '') : '';
      
      const url = phone ? `https://wa.me/91${phone}?text=${encoded}` : `https://wa.me/?text=${encoded}`;
      window.open(url, '_blank');
