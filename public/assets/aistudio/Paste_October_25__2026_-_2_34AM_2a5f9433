    function downloadSelfApp() {
      try {
        const pageContent = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
        const blob = new Blob([pageContent], { type: 'text/html;charset=utf-8' });
        
        // Method 1: Blob URL
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'AVHII_DATABASE_APP_1.0.html';
        document.body.appendChild(a);
        a.click();
        setTimeout(() => {
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        }, 1500);
        showToast('App download ho raha hai! Check your downloads.');
      } catch (e1) {
        // Method 2: Data URI fallback
        try {
          const pageContent = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
          const a = document.createElement('a');
          a.href = 'data:text/html;charset=utf-8,' + encodeURIComponent(pageContent);
          a.download = 'AVHII_DATABASE_APP_1.0.html';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          showToast('App downloaded successfully!');
        } catch (e2) {
          copyCompleteAppCode();
        }
      }
    }

    function copyCompleteAppCode() {
      const pageContent = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
      const tempTextArea = document.createElement('textarea');
      tempTextArea.value = pageContent;
      document.body.appendChild(tempTextArea);
      tempTextArea.select();
      try {
        document.execCommand('copy');
        showToast('Pura App Code copy ho gaya! Kisi file me paste karein.', 'success');
      } catch (err) {
        showToast('Copy nahi ho paya, please browser permissions check karein.', 'warning');
      }
      document.body.removeChild(tempTextArea);
    }

    function exportDataJSON() {
      try {
        const exportObj = {
          app: 'AVHII DATABASE APP 1.0',
          exportedAt: new Date().toISOString(),
          rentRecords: state.rentRecords,
          dailyExpenses: state.dailyExpenses,
          rationItems: state.rationItems,
          electricityLogs: state.electricityLogs
        };
        const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(exportObj, null, 2));
        const dlAnchor = document.createElement('a');
        dlAnchor.setAttribute("href", dataStr);
        dlAnchor.setAttribute("download", `AVHII_DATABASE_BACKUP_${new Date().toISOString().slice(0, 10)}.json`);
        document.body.appendChild(dlAnchor);
        dlAnchor.click();
        dlAnchor.remove();
        showToast('Database backup downloaded!');
      } catch (err) {
        showToast('Export failed', 'warning');
      }
    }

    function importDataJSON(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const parsed = JSON.parse(e.target.result);
          if (parsed.rentRecords) state.rentRecords = parsed.rentRecords;
          if (parsed.dailyExpenses) state.dailyExpenses = parsed.dailyExpenses;
          if (parsed.rationItems) state.rationItems = parsed.rationItems;
          if (parsed.electricityLogs) state.electricityLogs = parsed.electricityLogs;
          renderAll();
          closeModal('downloadModal');
          showToast('Database restored successfully from backup!');
        } catch (err) {
          showToast('Invalid backup JSON file', 'warning');
        }
      };
      reader.readAsText(file);
    }
  </script>

